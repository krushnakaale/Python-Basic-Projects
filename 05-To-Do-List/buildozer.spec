[app]
title = Smart To-Do List
package.name = smarttodo
package.domain = org.krushnakaale
source.dir = .
source.include_exts = py,json,kv,png
source.exclude_dirs = tests,scripts,builds,.venv,.venv-linux,dist,build
version = 1.0.0
requirements = python3,kivy
orientation = portrait
fullscreen = 0
android.archs = arm64-v8a
[buildozer]
log_level = 2
warn_on_root = 1
