[app]
title = Password Generator
package.name = passwordgenerator
package.domain = org.krushnakaale
source.dir = .
source.include_exts = py,kv,png,jpg,atlas
source.exclude_dirs = .venv,.venv-linux,tests,scripts,builds,build,dist,.buildozer
version = 1.0.0
requirements = python3,kivy
orientation = portrait
fullscreen = 0
android.archs = arm64-v8a
android.minapi = 23
[buildozer]
log_level = 2
warn_on_root = 1
